#!/usr/bin/env bash
set -uo pipefail

CPU_CONTAINER="anagen-x-ollama"
GPU_CONTAINER="anagen-x-ollama-gpu"
GPU_IMAGE="ollama/ollama:rocm"
# Machine-specific GPU flags: AMD Radeon RX 9700 (RDNA), render group 992.
GPU_DEVICES=(
    --device /dev/kfd
    --device /dev/dri/renderD128
    --group-add video
    --group-add 992
    --memory=8g
    -e HSA_OVERRIDE_GFX_VERSION=11.0.0
    -e ROCM_VISIBLE_DEVICES=0
)
PACKAGE_MARKER='__HEXDOCS_PACKAGE__:'
LATEST_VERSION='latest'
# Credo's duplicate chunk keys crash hexdocs-mcp 0.6.0.
SKIP_PACKAGES=('credo')
usage() {
    cat <<'EOF'
Usage: hexdocs-update [--force] <repo> [repo ...]

Updates the hexdocs-mcp npm package, runs `mix deps.get` in each repo,
then fetches embeddings for every apps/*/ app in each repo using
GPU-accelerated Ollama. Restores the CPU Ollama container when done.

  --force  re-fetch all embeddings (passed through to every fetch)

Each repo is resolved as given, or under ~/code if not found.
EOF
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ ! -f "$SCRIPT_DIR/hexdocs-common.sh" ]; then
    echo "Error: $SCRIPT_DIR/hexdocs-common.sh not found (re-run install.sh)" >&2
    exit 1
fi
# shellcheck source=extra/hexdocs-common.sh
source "$SCRIPT_DIR/hexdocs-common.sh"

cleanup() {
    echo -e "\n=== Restoring CPU Ollama ==="
    docker stop "$GPU_CONTAINER" >/dev/null 2>&1 || true
    docker rm "$GPU_CONTAINER" >/dev/null 2>&1 || true
    docker start "$CPU_CONTAINER" >/dev/null 2>&1 || true
}

resolve_repo() {
    local arg="$1"
    if [ -d "$arg/apps" ]; then
        echo "$arg"
        return 0
    fi
    local candidate="$HOME/code/$arg"
    if [ -d "$candidate/apps" ]; then
        echo "$candidate"
        return 0
    fi
    echo "Error: repo '$arg' not found (checked '$arg' and '$candidate'); expected apps/*/ subdirectories" >&2
    return 1
}

ensure_cpu_container() {
    # The CPU container is the idle state; it must exist so cleanup can restore it.
    if ! docker ps -a --filter name="$CPU_CONTAINER" --format '{{.Names}}' 2>/dev/null | grep -q "^$CPU_CONTAINER$"; then
        echo "=== Creating CPU Ollama container ==="
        docker run -d --name "$CPU_CONTAINER" -p 11434:11434 \
            -v "$OLLAMA_VOLUME:/root/.ollama" "$OLLAMA_IMAGE" >/dev/null || {
            echo "Error: failed to create CPU Ollama container" >&2
            return 1
        }
    fi
}

ensure_gpu_ollama() {
    echo "=== Stopping CPU Ollama ==="
    docker stop "$CPU_CONTAINER" >/dev/null 2>&1 || true
    echo "=== Starting GPU Ollama ==="
    docker rm -f "$GPU_CONTAINER" >/dev/null 2>&1 || true
    docker run -d \
        --name "$GPU_CONTAINER" \
        "${GPU_DEVICES[@]}" \
        -p 11434:11434 \
        -v anagen-x_ollama_data:/root/.ollama \
        "$GPU_IMAGE" >/dev/null || {
        echo "Error: failed to start GPU Ollama container" >&2
        return 1
    }
}

ensure_model() {
    # Ensure the embedding model exists, pulling it if missing. The pull
    # streams JSON lines ending in {"status":"success"} on success or an
    # error object on failure; check the final line rather than curl's exit.
    echo "=== Checking model ==="
    if curl -s "$OLLAMA_URL/api/show" -d "{\"name\": \"$MODEL\"}" >/dev/null 2>&1; then
        return 0
    fi
    echo "Pulling $MODEL..."
    local last
    last="$(curl -s "$OLLAMA_URL/api/pull" -d "{\"name\": \"$MODEL\"}" | tail -1)" || {
        echo "Error: failed to pull model $MODEL (curl error)" >&2
        return 1
    }
    if ! printf '%s' "$last" | grep -q '"status":"success"'; then
        echo "Error: failed to pull model $MODEL" >&2
        return 1
    fi
}

project_hex_packages() {
    local mix_file="$1"
    local project_dir="${mix_file%/*}"
    (
        cd "$project_dir" || return 1
        mix run --no-deps-check --no-compile --no-start -e '
            locks = Mix.Dep.Lock.read()
            latest_version = "latest"

            emit_package = fn app ->
                version =
                    case Map.get(locks, app) do
                        {:hex, _package, version, _checksum, _managers, _deps, _repo, _outer_checksum}
                        when is_binary(version) and version != "" ->
                            version

                        _ ->
                            latest_version
                    end

                IO.puts("__HEXDOCS_PACKAGE__:" <> to_string(app) <> ":" <> version)
            end

            hex_dep? = fn opts ->
                (Keyword.get(opts, :version) != nil or Keyword.get(opts, :hex) != nil) and
                    not Enum.any?([:path, :git, :github], &Keyword.has_key?(opts, &1))
            end

            Mix.Project.config()
            |> Keyword.get(:deps, [])
            |> Enum.each(fn
                {app, version} when is_binary(version) ->
                    emit_package.(app)

                {app, opts} when is_list(opts) ->
                    if hex_dep?.(opts), do: emit_package.(app)

                {app, version, opts} when is_binary(version) and is_list(opts) ->
                    unless Enum.any?([:path, :git, :github], &Keyword.has_key?(opts, &1)) do
                        emit_package.(app)
                    end

                _ ->
                    :ok
            end)
        '
    )
}

package_is_skipped() {
    local package="$1" skipped_package
    for skipped_package in "${SKIP_PACKAGES[@]}"; do
        [ "$package" = "$skipped_package" ] && return 0
    done
    return 1
}

fetch_package_docs() {
    local app="$1" package="$2" version="$3" force="$4"
    local force_args=()
    [ -n "$force" ] && force_args+=("$force")
    # The fetch process must not consume the package list driving the caller's loop.
    if ! "$HEXDOCS_BIN" fetch "$package" "$version" --model "$MODEL" "${force_args[@]}" </dev/null; then
        echo "Warning: fetch failed for package $package in $(basename "$app")"
        rm -f erl_crash.dump
    fi
}

fetch_repo() {
    local repo="$1" force="$2"
    local app package_output line package package_info version found
    local force_args=()
    [ -n "$force" ] && force_args+=("$force")
    (
        # cd into the repo so Mix resolves against the repo's .tool-versions.
        cd "$repo" || { echo "Warning: cannot enter $repo, skipping" >&2; exit 1; }
        for app in apps/*/; do
            [ -d "$app" ] || continue
            app="${app%/}"
            [ -f "$app/mix.exs" ] || continue
            echo -e "\n=== Fetching docs for $(basename "$app") ==="
            if ! package_output="$(project_hex_packages "$app/mix.exs")"; then
                echo "Warning: could not list Hex packages for $(basename "$app"), falling back to app-wide fetch" >&2
                if ! "$HEXDOCS_BIN" fetch --project "$app/mix.exs" --model "$MODEL" "${force_args[@]}"; then
                    echo "Warning: fetch failed for $(basename "$app")"
                    rm -f erl_crash.dump
                fi
                continue
            fi
            found=0
            while IFS= read -r line; do
                case "$line" in
                    "$PACKAGE_MARKER"*)
                        package_info="${line#"$PACKAGE_MARKER"}"
                        IFS=: read -r package version <<< "$package_info"
                        version="${version:-$LATEST_VERSION}"
                        [ -n "$package" ] || continue
                        found=1
                        if package_is_skipped "$package"; then
                            echo "Skipping excluded package $package $version"
                            continue
                        fi
                        fetch_package_docs "$app" "$package" "$version" "$force"
                        ;;
                esac
            done <<< "$package_output"
            [ "$found" -eq 1 ] || echo "No Hex dependencies found for $(basename "$app")"
        done
    )
}

mix_deps_get() {
    # Fetch deps inside the repo so its lockfile/.tool-versions apply. A
    # failure is a warning, not fatal: package fetches report missing deps.
    local repo="$1"
    echo "=== Updating deps in $repo ==="
    if ! ( cd "$repo" && mix deps.get ); then
        echo "Warning: mix deps.get failed in $repo (fetches may fail for missing deps)" >&2
    fi
}

main() {
    local force="" arg
    local raw_repos=()
    for arg in "$@"; do
        case "$arg" in
            -h | --help)
                usage
                return 0
                ;;
            --force)
                force="--force"
                ;;
            -*)
                echo "Error: unknown option: $arg" >&2
                usage >&2
                return 2
                ;;
            *)
                raw_repos+=("$arg")
                ;;
        esac
    done
    if [ "${#raw_repos[@]}" -eq 0 ]; then
        usage >&2
        return 2
    fi

    local repos=()
    local repo resolved
    for repo in "${raw_repos[@]}"; do
        resolved="$(resolve_repo "$repo")" || return 1
        repos+=("$resolved")
    done

    # Only arm cleanup once real work begins. Help, usage errors, and
    # repo resolution run before any container is touched, so they must
    # not print the "Restoring CPU Ollama" banner on exit.
    trap cleanup EXIT

    echo "=== Updating hexdocs-mcp ==="
    npm update -g hexdocs-mcp || {
        echo "Error: npm update -g hexdocs-mcp failed" >&2
        return 1
    }

    HEXDOCS_BIN="$(hexdocs_bin)" || return 1
    echo "Using binary: $HEXDOCS_BIN"

    ensure_cpu_container || return 1
    ensure_gpu_ollama || return 1
    echo "Waiting for Ollama..."
    wait_ollama || return 1
    ensure_model || return 1

    for repo in "${repos[@]}"; do
        mix_deps_get "$repo"
        fetch_repo "$repo" "$force"
    done

    echo -e "\n=== Done ==="
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
